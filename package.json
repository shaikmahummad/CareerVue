{
  "name": "careervue",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "npm run lint --workspace=@careervue/web && npm run lint --workspace=@careervue/mobile && tsc -p packages/api-client/tsconfig.json --noEmit",
    "test:backend": "cd backend && python -m unittest discover -s tests -v",
    "test:selenium": "python -m pytest tests/selenium -v --junitxml=artifacts/selenium/junit-results.xml --html=artifacts/selenium/report.html --self-contained-html",
    "test:appium": "python -m pytest tests/appium -v --junitxml=artifacts/appium/junit-results.xml --html=artifacts/appium/report.html --self-contained-html",
    "test:catalogs": "python scripts/ci/generate_test_catalogs.py",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
    "test:load": "python tests/load/run_load_tests.py",
    "test:dast": "python tests/dast/run_dast_tests.py",
    "bundle:reports": "python scripts/ci/bundle_reports.py"
  },
  "devDependencies": {
    "@expo/dom-webview": "58.0.2",
    "@expo/log-box": "58.0.15",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-font": "58.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@expo/dom-webview": "58.0.2",
    "@expo/log-box": "58.0.15",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-splash-screen": "58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-worklets": "0.13.0"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "^1.32.0"
  }
}
