{
  "expo": {
    "name": "CareerVue",
    "slug": "careervue-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "careervue",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.careervue.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050508"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.careervue.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050508"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
