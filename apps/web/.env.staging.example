# Public staging client configuration. Values must identify the dedicated
# staging backend and staging Supabase project, never production or development.
NEXT_PUBLIC_API_URL=https://STAGING_API_HOST
NEXT_PUBLIC_SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-anon-key
