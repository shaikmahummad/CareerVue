# Copy these names into `.env.staging.local` or the staging platform's secret
# store. Never put real values in this tracked example.
APP_ENV=staging
DATABASE_URL=postgresql+asyncpg://STAGING_DB_USER:STAGING_DB_PASSWORD@STAGING_DB_HOST:5432/STAGING_DB_NAME
SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-with-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
JWT_SECRET=replace-with-a-new-staging-only-secret
JWT_ALGORITHM=HS256

# Application-owned signup verification email. Store real credentials only in
# the deployment secret store.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-staging-smtp-user
SMTP_PASSWORD=replace-with-staging-smtp-password
SMTP_FROM_EMAIL=no-reply@staging.example.com
SMTP_FROM_NAME=CareerVue
FRONTEND_URL=https://STAGING_WEB_HOST

# Optional. Leave blank while payments are intentionally disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

APP_CORS_ORIGINS=["https://STAGING_WEB_HOST"]
QUIZ_ATTEMPT_START_LIMIT=5
QUIZ_ATTEMPT_START_WINDOW_SECS=600
QUIZ_MAX_ACTIVE_ATTEMPTS=2
QUIZ_ABANDONED_GRACE_SECS=3600
QUIZ_CLEANUP_INTERVAL_SECS=900
QUIZ_CLEANUP_BATCH_SIZE=500
QUIZ_CLEANUP_ENABLED=true
